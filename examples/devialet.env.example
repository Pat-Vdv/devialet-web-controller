# Example settings for devialet_web. Copy to a file outside the repository (e.g. ~/.config/devialet-web/env),
# fill in YOUR values, then:  set -a; . ~/.config/devialet-web/env; set +a; python -m devialet_web
# 192.0.2.x are documentation addresses (RFC 5737): replace them with your speakers' IPs.

DEVIALET_HOSTS=192.0.2.10,192.0.2.11
# or automatic discovery on your private subnet (at most /22):
# DEVIALET_SUBNETS=192.168.1.0/24
# DEVIALET_SYSTEM=My Phantom System

DEVIALET_MAX_VOLUME=40
DEVIALET_PORT=8000
DEVIALET_BIND=127.0.0.1

# Equalizer APO folder as seen from WSL; empty to disable the graphic equalizer.
# DEVIALET_EAPO_CONFIG=/mnt/c/Program Files/EqualizerAPO/config

# --- LAN access (off by default; read README "Accès depuis le réseau local" first) ---
# DEVIALET_ALLOW_LAN=1
# DEVIALET_BIND=0.0.0.0
# DEVIALET_ALLOWED_HOSTS=controller.lan,192.0.2.20
# DEVIALET_ACCESS_TOKEN=<at least 32 random characters, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))">

# eapo-check.ps1 (Windows): output to inspect
# DEVIALET_EAPO_DEVICE=My Phantom System
# Spectrum agent (Windows): output to capture, part of its name
# DEVIALET_AGENT_DEVICE=My Phantom System
